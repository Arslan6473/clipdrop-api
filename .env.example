# Long random string; set the same value as DOWNLOADER_API_KEY in the Next.js app.
API_KEY=
# This service's public URL on Railway (used to build file links).
PUBLIC_BASE_URL=https://your-service.up.railway.app
# Your website's origin(s), comma separated.
ALLOWED_ORIGINS=https://clipdrop.example
MAX_FILESIZE_MB=1024
MAX_DURATION_SECONDS=10800
MAX_CONCURRENT_DOWNLOADS=3
FILE_TTL_SECONDS=900
